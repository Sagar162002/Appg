from sklearn.datasets import load_iris
from sklearn.tree import DecisionTreeClassifier, export_text, plot_tree
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score
import matplotlib.pyplot as plt
# Step 1: Load a dataset (Iris dataset for demonstration)
data = load_iris()
X = data.data # Features
y = data.target # Target labels
feature_names = data.feature_names
class_names = data.target_names
# Step 2: Split the dataset into training and testing sets
X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.3, random_state=42)
# Step 3: Train a decision tree classifier using the "entropy" criterion (ID3 algorithm)
id3_tree = DecisionTreeClassifier(criterion="entropy", random_state=42)
id3_tree.fit(X_train, y_train)
# Step 4: Evaluate the model
y_pred = id3_tree.predict(X_test)
accuracy = accuracy_score(y_test, y_pred)
print(f"Model Accuracy: {accuracy * 100:.2f}%")
# Step 5: Visualize the decision tree
plt.figure(figsize=(12, 8))
plot_tree(id3_tree, feature_names=feature_names, class_names=class_names, filled=True)
plt.title("ID3 Decision Tree")
plt.show()
# Step 6: Display the rules of the decision tree
tree_rules = export_text(id3_tree, feature_names=feature_names)
print("\nDecision Tree Rules:\n")
print(tree_rules)
